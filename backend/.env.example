# Copia este archivo como .env (no se versiona) y completa los valores.
# Lo leen docker-compose.dev.yml y el perfil dev de Spring Boot.

# PostgreSQL
DB_NAME=facturacion
DB_URL=jdbc:postgresql://localhost:5432/facturacion
DB_USER=facturacion
DB_PASSWORD=

# JWT: al menos 32 caracteres aleatorios. Ejemplo para generarlo: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION=8h

# Administrador que se crea solo si la tabla de usuarios está vacía (clave de 12 caracteres o más)
ADMIN_NOMBRE=Administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Consulta de RUC y DNI para autocompletar formularios. Sin token, la consulta queda deshabilitada
CONSULTA_DOCUMENTOS_URL=https://api.apifacturacion.com
CONSULTA_DOCUMENTOS_TOKEN=

# SUNAT (en dev se usa beta). Credenciales SOL del emisor
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=

# Certificado digital .pfx / .p12 (fuera del repositorio)
CERT_PATH=
CERT_PASSWORD=
